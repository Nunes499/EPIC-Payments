{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "epic-payments-container-test",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "containers": [
    {
      "class_name": "EpicBackend",
      "image": "../backend/Dockerfile",
      "image_build_context": "../backend",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EPIC_BACKEND",
        "class_name": "EpicBackend"
      }
    ]
  },
  "exports": {
    "EpicBackend": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
